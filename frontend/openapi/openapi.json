{
  "openapi": "3.1.0",
  "info": {
    "title": "Failure Forensics API",
    "version": "0.1.0-draft",
    "description": "PROVISIONAL console-side draft so the typed client can be generated before KAN-35 publishes contract v1. Shapes follow docs/design/data-model.md. Replace this file with the published contract when KAN-35 lands; do not treat it as the source of truth."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": { "status": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "/v1/traces": {
      "get": {
        "operationId": "listTraces",
        "summary": "List traces with filters",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/TraceStatus" }
          },
          {
            "name": "health",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/TraceHealth" }
          },
          {
            "name": "pipeline_version",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "started_after",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "started_before",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "flagged",
            "in": "query",
            "schema": { "type": "boolean" }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of traces",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TraceListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/traces/{trace_id}": {
      "get": {
        "operationId": "getTrace",
        "summary": "Trace detail with spans and links",
        "parameters": [
          {
            "name": "trace_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The trace",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TraceDetail" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["detail"],
        "properties": { "detail": { "type": "string" } }
      },
      "TraceStatus": {
        "type": "string",
        "enum": ["ok", "error", "incomplete"]
      },
      "TraceHealth": {
        "type": "string",
        "enum": ["healthy", "degraded", "failed", "unknown"]
      },
      "FeedbackStatus": {
        "type": "string",
        "enum": ["none", "flagged", "reviewed"]
      },
      "Trace": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "started_at",
          "status",
          "health",
          "pipeline_version",
          "feedback_status"
        ],
        "properties": {
          "id": { "type": "string" },
          "project_id": { "type": "string" },
          "external_trace_id": { "type": ["string", "null"] },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": ["string", "null"], "format": "date-time" },
          "status": { "$ref": "#/components/schemas/TraceStatus" },
          "health": { "$ref": "#/components/schemas/TraceHealth" },
          "root_span_id": { "type": ["string", "null"] },
          "total_latency_ms": { "type": ["integer", "null"] },
          "total_input_tokens": { "type": ["integer", "null"] },
          "total_output_tokens": { "type": ["integer", "null"] },
          "estimated_cost_usd": {
            "type": ["string", "null"],
            "description": "Decimal(12,6) serialised as a string"
          },
          "pipeline_version": { "type": "string" },
          "git_commit": { "type": ["string", "null"] },
          "tags": { "type": "object", "additionalProperties": true },
          "feedback_status": { "$ref": "#/components/schemas/FeedbackStatus" }
        }
      },
      "TraceListResponse": {
        "type": "object",
        "required": ["items", "page", "page_size", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Trace" }
          },
          "page": { "type": "integer" },
          "page_size": { "type": "integer" },
          "total": { "type": "integer" }
        }
      },
      "SpanType": {
        "type": "string",
        "enum": [
          "llm",
          "retrieval",
          "reranker",
          "tool",
          "agent",
          "transform",
          "guardrail",
          "custom"
        ]
      },
      "SpanStatus": {
        "type": "string",
        "enum": ["ok", "error", "timeout", "cancelled"]
      },
      "Span": {
        "type": "object",
        "required": [
          "id",
          "trace_id",
          "name",
          "component_key",
          "type",
          "started_at",
          "status"
        ],
        "properties": {
          "id": { "type": "string" },
          "trace_id": { "type": "string" },
          "parent_span_id": { "type": ["string", "null"] },
          "name": { "type": "string" },
          "component_key": { "type": "string" },
          "type": { "$ref": "#/components/schemas/SpanType" },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": ["string", "null"], "format": "date-time" },
          "latency_ms": { "type": ["integer", "null"] },
          "status": { "$ref": "#/components/schemas/SpanStatus" },
          "model_provider": { "type": ["string", "null"] },
          "model_name": { "type": ["string", "null"] },
          "input_tokens": { "type": ["integer", "null"] },
          "output_tokens": { "type": ["integer", "null"] },
          "estimated_cost_usd": { "type": ["string", "null"] },
          "error_type": { "type": ["string", "null"] },
          "error_message": { "type": ["string", "null"] },
          "attributes": { "type": "object", "additionalProperties": true }
        }
      },
      "SpanLink": {
        "type": "object",
        "required": ["from_span_id", "to_span_id", "relation"],
        "properties": {
          "from_span_id": { "type": "string" },
          "to_span_id": { "type": "string" },
          "relation": {
            "type": "string",
            "enum": ["consumes_output_of", "retries", "follows"]
          }
        }
      },
      "TraceDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Trace" },
          {
            "type": "object",
            "required": ["spans", "links"],
            "properties": {
              "spans": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Span" }
              },
              "links": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/SpanLink" }
              }
            }
          }
        ]
      }
    }
  }
}
